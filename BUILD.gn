import("//build/boards/${board}.gni")
import("//build/templates/build_template.gni")

if (chip == "esp32c3") {
  _include_headers = [
    "components/hal/include",
    "components/esp_hal_uart/include",
    "components/esp_hal_uart/esp32c3/include",
    "components/soc/esp32c3/register",
    "components/hal/platform_port/include",
    "components/soc/esp32c3/include",
    "components/esp_hw_support/include",
    "components/log/include",
    "components/esp_rom/include",
    "components/esp_hw_support/port/esp32c3/include",
    "components/esp_hal_clock/include",
    "components/esp_hal_clock/esp32c3/include",
    "components/hal/esp32c3/include",
    "components/esp_rom/esp32c3/include",
    "components/esp_hw_support/port/include",
    "components/esp_hal_rtc_timer/esp32c3/include",
    "components/esp_hal_timg/esp32c3/include",
    "components/esp_rom/esp32c3",
    "components/esp_system/include",
    "components/riscv/include",
    "components/soc/include",
    "components/esp_rom/esp32c3/include/esp32c3",
    "components/esp_hal_gpio/include",
    "components/hal/esp32c3/include",
    "components/esp_hw_support/include/esp_private",
    "components/esp_hal_wdt/esp32c3/include",
    "components/esp_hal_wdt/include",
    "components/hal/include",
    "components/esp_system/port/include",
    "components/esp_hal_usb/esp32c3/include",
    "components/esp_hal_usb/include",
    "components/esp_hal_ana_conv/include",
    "components/esp_hal_ana_conv/esp32c3/include",
    "components/bootloader_support/include",
    "components/esp_hal_security/include",
    "components/esp_timer/include",
    "components/spi_flash/include",
    "components/esp_hal_mspi/include",
    "components/esp_hal_mspi/esp32c3/include",
    "components/esp_hal_gpspi/include",
    "components/esp_blockdev/include",
    "."
  ]
  _src_files = [
    "components/hal/mmu_hal.c",
    "components/hal/cache_hal.c",
    "components/esp_hal_uart/uart_hal.c",
    "components/esp_hal_uart/uart_hal_iram.c",

    "components/esp_hw_support/esp_clk.c",
    "components/esp_hw_support/periph_ctrl.c",
    "components/esp_hw_support/port/esp_clk_tree_common.c",
    "components/esp_hw_support/port/esp32c3/esp_clk_tree.c",
    "components/esp_hw_support/port/esp32c3/rtc_clk.c",
    "components/esp_hw_support/port/esp32c3/rtc_time.c",

    "components/esp_rom/patches/esp_rom_crc.c",
    "components/esp_rom/patches/esp_rom_efuse.c",
    "components/esp_rom/patches/esp_rom_gpio.c",
    "components/esp_rom/patches/esp_rom_sys.c",
    "components/esp_rom/patches/esp_rom_print.c",
    "components/esp_rom/patches/esp_rom_spiflash.c",
    "components/esp_rom/patches/esp_rom_systimer.c",
    "components/esp_hal_wdt/wdt_hal_iram.c",
    "components/esp_hal_clock/esp32c3/clk_tree_hal.c",
    "components/log/src/noos/log_timestamp.c",
    "components/esp_system/port/soc/esp32c3/clk.c",
    "components/esp_hw_support/port/esp32c3/rtc_init.c",
    "components/log/src/log.c",
    "components/esp_hw_support/port/esp32c3/sar_periph_ctrl.c",
    "components/esp_hw_support/port/esp32c3/rtc_sleep.c",
    "components/hal/efuse_hal.c",
    "components/hal/esp32c3/efuse_hal.c",

    "components/riscv/rv_utils.c",
    # "components/riscv/interrupt_plic.c",
    # "components/esp_hw_support/port/esp32c3/cpu_region_protect.c",
    # "components/bootloader_support/src/bootloader_mem.c",
    # "components/esp_hw_support/sleep_modes.c",
  ]
  _cflags = [
    "-DCONFIG_IDF_TARGET_ARCH_RISCV",
    "-DCONFIG_SOC_SERIES_ESP32C3",
    "-DBOOTLOADER_BUILD",
    "-DESP_PLATFORM",
    "-DNON_OS_BUILD=1",
    "-Dasm=__asm__",
  ]
} else {
  _include_headers = []
  _cflags = []
  _src_files = []
}

_include_headers += [
  "components/esp_common/include",
]

static_library("hal_espressif") {
  sources = [
    "helpers.c",
  ]
  sources += _src_files
  include_dirs = _include_headers
  cflags = _cflags
  configs += [ "//build/boards/${board}:kernel_config" ]
}

bindgen("hal_espressif_header") {
  bindgen_flags = [
    "--use-core",
    "--ctypes-prefix",
    "core::ffi",
    "--blocklist-function",
    "strtold",
    "--blocklist-function",
    "_strtold_r",
    "--blocklist-file",
    "esp_compiler.h",
  ]
  sources = [ "hal_headers.h" ]
  configs += [ "//build/boards/${board}:kernel_config" ]
  include_dirs = _include_headers
}

build_rust("hal_espressif_rs") {
  crate_type = "rlib"
  sources = [ "src/lib.rs" ]
  deps = [ ":hal_espressif_header" ]
  output_file = get_target_outputs(":hal_espressif_header")
  rustenv = [ "BINDGEN_DIR=" + rebase_path(output_file[0]) ]
}
